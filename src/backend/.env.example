# Copy to .env and fill in. Never commit .env.
# Business thresholds (anomaly threshold, tracing window, weights, log retention)
# are stored in the settings table, not here.

# --- Application ---
APP_ENV=development              # development | test | production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL 15+) ---
DATABASE_URL=postgresql+psycopg://cic:change-me@localhost:5432/cic
DATABASE_SCHEMA=cic

# --- Authentication ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- File storage for ticket imports ---
FILE_STORAGE_DIR=./storage/imports
IMPORT_MAX_FILE_MB=10
IMPORT_MAX_ROWS=5000

# --- LLM provider (only masked data is sent) ---
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Worker ---
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_SECONDS=5
